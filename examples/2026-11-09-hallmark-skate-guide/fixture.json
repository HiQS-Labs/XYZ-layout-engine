    },
    {
      "id": "board_desc",
      "type": "text",
      "x": 72,
      "y": 312,
      "width": 456,
      "height": 144,
      "text": "Eight bolts anchor the trucks to the maple deck. The nose points in your direction of roll; the tail curves up to allow pop and clearance. Grip tape holds rubber soles firmly.",
      "role": "body",
      "color": "ink",
      "align": "left"
    },
    {
      "id": "board_safety",
      "type": "text",
      "x": 72,
      "y": 480,
      "width": 456,
      "height": 120,
      "text": "RULE ZERO: Always wear helmet, wrist guards, and pads before stepping on the grip. Flat rubber-soled skate shoes are non-negotiable.",
      "role": "body",
      "color": "muted",
      "align": "left"
    },
    {
      "id": "board_image",
      "type": "image",
      "x": 552,
      "y": 240,
      "width": 576,
      "height": 360,
      "asset": "board_blueprint",
      "alt": "Technical perspective view of complete skateboard."
