    {
      "id": "step1_num",
      "type": "text",
      "x": 72,
      "y": 672,
      "width": 144,
      "height": 96,
      "text": "1.0",
      "role": "display",
      "color": "accent",
      "align": "left"
    },
    {
      "id": "step1_title",
      "type": "text",
      "x": 240,
      "y": 672,
      "width": 888,
      "height": 72,
      "text": "FIND YOUR STANCE",
      "role": "display",
      "color": "ink",
      "align": "left"
    },
    {
      "id": "step1_body",
      "type": "text",
      "x": 240,
      "y": 744,
      "width": 888,
      "height": 72,
      "text": "Feet set across the width of the board, each foot resting directly over a set of truck bolts. Keep your knees flexed and center of mass low. Try this stationary on grass or carpet first so the wheels cannot roll out.",
      "role": "body",
      "color": "ink",
      "align": "left"
    },
    {
      "id": "card_step2",
      "type": "rect",
      "x": 48,
      "y": 864,
      "width": 1104,
      "height": 192,
      "fill": "surface",
      "stroke": "ink"
    },
    {
      "id": "step2_num",
      "type": "text",
      "x": 72,
      "y": 888,
      "width": 144,
      "height": 96,
      "text": "2.0",
      "role": "display",
      "color": "accent",
      "align": "left"
    },
    {
      "id": "step2_title",
      "type": "text",
      "x": 240,
      "y": 888,
      "width": 888,
      "height": 72,
      "text": "PUSH OFF",
      "role": "display",
      "color": "ink",
      "align": "left"
    },
    {
      "id": "step2_body",
      "type": "text",
      "x": 240,
      "y": 960,
      "width": 888,
      "height": 72,
      "text": "Turn your front foot to point straight forward toward the nose over the front bolts. Lower your hips and push steadily against the asphalt with your back foot. Once rolling, bring the back foot onto the tail bolts and pivot sideways.",
      "role": "body",
      "color": "ink",
      "align": "left"
    },
    {
      "id": "card_step3",
      "type": "rect",
      "x": 48,
      "y": 1080,
      "width": 1104,
      "height": 192,
      "fill": "surface",
      "stroke": "ink"
    },
    {
      "id": "step3_num",
      "type": "text",
      "x": 72,
      "y": 1104,
      "width": 144,
      "height": 96,
      "text": "3.0",
      "role": "display",
      "color": "accent",
      "align": "left"
    },
    {
      "id": "step3_title",
      "type": "text",
      "x": 240,
      "y": 1104,
      "width": 888,
      "height": 72,
      "text": "LEAN TO TURN (CARVING)",
      "role": "display",
      "color": "ink",
      "align": "left"
    },
    {
      "id": "step3_body",
      "type": "text",
      "x": 240,
      "y": 1176,
      "width": 888,
      "height": 72,
      "text": "Steering does not require lifting the board. Press weight into your toes to carve toe-side; lean gently into your heels to curve heel-side. The rubber bushings inside the metal trucks compress and steer the wheelbase.",
      "role": "body",
      "color": "ink",
      "align": "left"
    },
    {
      "id": "card_step4",
      "type": "rect",
      "x": 48,
      "y": 1296,
      "width": 1104,
      "height": 192,
      "fill": "surface",
      "stroke": "ink"
    },
    {
      "id": "step4_num",
      "type": "text",
      "x": 72,
      "y": 1320,
      "width": 144,
      "height": 96,
      "text": "4.0",
      "role": "display",
      "color": "accent",
      "align": "left"
    },
    {
      "id": "step4_title",
      "type": "text",
      "x": 240,
      "y": 1320,
      "width": 888,
      "height": 72,
      "text": "FOOT BRAKE TO STOP",
      "role": "display",
      "color": "ink",
      "align": "left"
    },
    {
      "id": "step4_body",
      "type": "text",
      "x": 240,
      "y": 1392,
      "width": 888,
      "height": 72,
      "text": "Do not jump off a moving board. Rotate your front foot parallel to the deck, gently take the back foot off, and drag the flat rubber sole along the ground with increasing friction until you come to a smooth, controlled halt.",
      "role": "body",
      "color": "ink",
      "align": "left"
    },
