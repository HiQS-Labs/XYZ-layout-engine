    "panel_why_title": {
      "x": 142,
      "y": 1100,
      "width": 212.02,
      "height": 24,
      "text": "WHY IT MATTERS",
      "scrollWidth": 1007,
      "clientWidth": 1007,
      "scrollHeight": 26,
      "clientHeight": 26,
      "lineCount": 1
    },
    "panel_why_body": {
      "x": 142,
      "y": 1141,
      "width": 1005.69,
      "height": 70.8,
      "text": "Mitosis is how a body grows, replaces worn-out cells and heals wounds. When its checks fail, cells can divide out of control, as in cancer.",
      "scrollWidth": 1007,
      "clientWidth": 1007,
      "scrollHeight": 76,
      "clientHeight": 76,
      "lineCount": 2
    },
    "panel_same_title": {
      "x": 1262,
      "y": 1100,
      "width": 290.5,
      "height": 24,
      "text": "WHAT STAYS THE SAME",
      "scrollWidth": 1007,
      "clientWidth": 1007,
      "scrollHeight": 26,
      "clientHeight": 26,
      "lineCount": 1
    },
    "panel_same_body": {
      "x": 1262,
      "y": 1141,
      "width": 994.45,
      "height": 70.8,
      "text": "Each daughter cell gets a full copy of the DNA: the same chromosomes, in the same number, as the parent cell.",
      "scrollWidth": 1007,
      "clientWidth": 1007,
      "scrollHeight": 76,
      "clientHeight": 76,
      "lineCount": 2
    },
