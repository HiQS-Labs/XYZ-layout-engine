      "height": 41,
      "text": "Anaphase",
      "scrollWidth": 264,
      "clientWidth": 264,
      "scrollHeight": 44,
      "clientHeight": 44,
      "lineCount": 1
    },
    "anaphase_desc": {
      "x": 1254,
      "y": 779.19,
      "width": 262.5,
      "height": 85.38,
      "text": "The sister chromatids are pulled apart toward opposite ends of the cell.",
