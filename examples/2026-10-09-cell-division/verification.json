    },
    "telophase_title": {
      "x": 1630,
      "y": 725,
      "width": 172,
      "height": 41,
      "text": "Telophase",
      "scrollWidth": 264,
      "clientWidth": 264,
      "scrollHeight": 44,
      "clientHeight": 44,
      "lineCount": 1
    },
    "telophase_desc": {
      "x": 1630,
      "y": 779.19,
      "width": 263.23,
      "height": 115.06,
      "text": "A new nuclear envelope forms around each of the two sets of chromosomes.",
      "scrollWidth": 264,
      "clientWidth": 264,
      "scrollHeight": 119,
      "clientHeight": 119,
      "lineCount": 4
    },
    "cytokinesis_step": {
