      "width": 157.55,
      "height": 41,
      "text": "Prophase",
      "scrollWidth": 264,
      "clientWidth": 264,
      "scrollHeight": 44,
      "clientHeight": 44,
      "lineCount": 1
    },
    "prophase_desc": {
      "x": 502,
      "y": 779.19,
      "width": 258.23,
      "height": 115.06,
      "text": "Chromosomes coil up into visible X shapes and the spindle begins to form.",
      "scrollWidth": 264,
      "clientWidth": 264,
      "scrollHeight": 119,
      "clientHeight": 119,
      "lineCount": 4
    },
