      "x": 878,
      "y": 725,
      "width": 185.92,
      "height": 41,
      "text": "Metaphase",
      "scrollWidth": 264,
      "clientWidth": 264,
      "scrollHeight": 44,
      "clientHeight": 44,
      "lineCount": 1
    },
    "metaphase_desc": {
      "x": 878,
      "y": 779.19,
      "width": 255.78,
      "height": 85.38,
      "text": "Spindle fibers line the chromosomes up across the middle of the cell.",
      "scrollWidth": 264,
      "clientWidth": 264,
      "scrollHeight": 89,
      "clientHeight": 89,
      "lineCount": 3
    },
    "anaphase_step": {
