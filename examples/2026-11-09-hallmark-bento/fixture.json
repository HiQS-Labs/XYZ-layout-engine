    {
      "id": "ur_body",
      "type": "text",
      "x": 720,
      "y": 312,
      "width": 408,
      "height": 120,
      "text": "Every font, asset, and token is vendored locally. Render pipelines execute offline with byte-for-byte reproducibility.",
      "role": "body",
      "color": "ink",
      "align": "left"
    },
    {
      "id": "mr_label",
      "type": "text",
      "x": 720,
